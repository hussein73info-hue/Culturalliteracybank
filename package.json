  "scripts": {
    "dev": "node server.js",
    "build": "vite build && mkdir -p dist/books && cp -rf public/books/* dist/books/ 2>/dev/null || true && cp -f questions.js aqyem_data.js glossary_data.js glossary_ui.js script.js style.css financial_culture_bank.doc financial_culture_bank.docx firebase-applet-config.json dist/ 2>/dev/null || true",
